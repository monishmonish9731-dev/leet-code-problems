class Solution {
    public int numTeams(int[] rating) {
        int n = rating.length;
        int teams = 0;

        for (int j = 0; j < n; j++) {
            int leftSmall = 0, leftLarge = 0;
            int rightSmall = 0, rightLarge = 0;

            // Count left side
            for (int i = 0; i < j; i++) {
                if (rating[i] < rating[j])
                    leftSmall++;
                else
                    leftLarge++;
            }

            // Count right side
            for (int k = j + 1; k < n; k++) {
                if (rating[k] > rating[j])
                    rightLarge++;
                else
                    rightSmall++;
            }

            // Increasing teams + Decreasing teams
            teams += leftSmall * rightLarge;
            teams += leftLarge * rightSmall;
        }

        return teams;
    }
}
